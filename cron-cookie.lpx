cron "24 6 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/lhtj/lhtj.js, tag=龙湖App签到, enable={lhtj_app}

# 九号出行签到(App)
http-request ^https?:\/\/[^\/]*\.ninebot\.com\/portal\/api\/user-sign\/v2\/ script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/refs/heads/main/Scripts/ninebot.js, requires-body=false, tag=九号出行获取Token, enable={ninebot}
cron "13 0 * * *" script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/refs/heads/main/Scripts/ninebot.js, tag=九号出行签到, enable={ninebot}

# 小米抽奖(小米商城App)
http-request ^https:\/\/shop-api\.retail\.mi\.com\/mtop\/navi\/venue\/batch tag=小米抽奖 Cookie, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js, requires-body=true, enable={milottery}
cron "27 6 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js, tag=小米抽奖签到, timeout=240, enable={milottery}

#林里LINLEE（小程序签到）·弃用
http-request ^https:\/\/webapi\.qmai\.cn\/web\/(cmk-center\/sign\/(activityInfo|userSignStatistics|userSignRecordCalendar)|catering\/common\/common-info|mall-apiserver\/integral\/(home\/index|item\/goods(\/detail)?)) tag=林里 Cookie, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/linli/linli.js, requires-body=true, enable={linlee}
cron "0 10 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/linli/linli.js, tag=林里签到兑换, enable={linlee}

#节点阻断检测
generic script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/loon/nodecheck/nodecheck.js, tag=节点阻断检测, timeout=20, img-url=bolt.horizontal.icloud.fill.system, enable={nodecheck}

#NodeSeek 随机窗口签到 V6@Minis修复
http-request ^https:\/\/www\.nodeseek\.com\/(?:$|board(?:$|[?#])|credit(?:$|[?#])|nodeseek-script\/reset(?:$|[?#])) script-path=https://gist.githubusercontent.com/onshine/c5e1df4d24a6961967ec4287b8897d2d/raw/NodeSeek.js, requires-body=false, timeout=5, tag=NodeSeek Cookie 抓取 V6@Minis修复, enable={nodeseek-minis}
cron "10-20 9 * * *" script-path=https://gist.githubusercontent.com/onshine/c5e1df4d24a6961967ec4287b8897d2d/raw/NodeSeek.js, timeout=120, tag=NodeSeek 随机窗口签到 V6@Minis修复, enable={nodeseek-minis}

# 林里签到兑换 R10.1@Minis修复
# 抓取脚本：保存签到接口完整来源请求头，并恢复 Cookie 获取成功通知
http-request ^https:\/\/[^\/]*qmai\.cn\/.* script-path=https://gist.githubusercontent.com/onshine/68e7a911c6a4f33d49481621f49349bc/raw/linlee.js, requires-body=true, timeout=20, tag=林里Cookie抓取通知R10.1@Minis修复, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/linli.png, enable={linlee-minis}
# 定时脚本：签到并按 Argument 开关执行免单券/周边兑换
cron "0 10 * * *" script-path=https://gist.githubusercontent.com/onshine/1c4061f48b31a607f705653f6e485933/raw/linlee-r10.2.js, timeout=300, argument=[{linli_task_exchange_coupon},{linli_task_exchange_toy}], tag=林里签到兑换R10.1@Minis修复, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/linli.png, enable={linlee-minis}

# 味多美签到 · 品牌动态修复版V2@Minis修复
http-request ^https:\/\/scrm-b\.zjian\.net\/api\/(member\/.*|marketing\/pointSignInActivitySet\/.*) tag=味多美原生请求V2@Minis修复, script-path=https://gist.githubusercontent.com/onshine/9e14c0d7e412dfa10e7f7e9671336da9/raw/wedome.js, requires-body=true, timeout=20, enable={wedome-minis}
http-response ^https:\/\/scrm-b\.zjian\.net\/api\/(member\/.*|marketing\/pointSignInActivitySet\/.*) tag=味多美原生响应V2@Minis修复, script-path=https://gist.githubusercontent.com/onshine/9e14c0d7e412dfa10e7f7e9671336da9/raw/wedome.js, requires-body=true, timeout=20, enable={wedome-minis}
cron "00 6 * * *" script-path=https://gist.githubusercontent.com/onshine/9e14c0d7e412dfa10e7f7e9671336da9/raw/wedome.js, timeout=300, tag=味多美签到V2@Minis修复, enable={wedome-minis}

